+void SidBackend::restoreEnvelope(int voice, const EnvelopeCue& cue, bool ownedGate) noexcept
+{
+    if (voice < 0 || voice >= 3 || !cue.valid || cue.expectedGate != ownedGate) return;
+    auto* env = chip->voice[voice].envelope();
+    env->lfsr = cue.lfsr; env->resetLfsr = cue.reset;
+    env->envelope_counter = static_cast<std::uint8_t>(cue.counter);
+    env->env3 = static_cast<std::uint8_t>(cue.counter);
+    env->exponential_counter = cue.exponential; env->exponential_counter_period = cue.period;
+    env->new_exponential_counter_period = cue.nextPeriod;
+    env->state = static_cast<reSIDfp::EnvelopeGenerator::State>(cue.state);
+    env->next_state = static_cast<reSIDfp::EnvelopeGenerator::State>(cue.nextState);
+    env->state_pipeline = cue.statePipeline; env->envelope_pipeline = cue.envelopePipeline;
+    env->exponential_pipeline = cue.exponentialPipeline; env->counter_enabled = cue.enabled;
+    env->rate = reSIDfp::EnvelopeGenerator::adsrtable[cue.rate];
+    // MIDI remains the sole gate owner. A cue cannot open/close a gate, touch
+    // oscillator phase/frequency, or replace the chip/shared filter.
+    env->gate = ownedGate;
+}
+unsigned SidBackend::envelopeValue(int voice) const noexcept
+{ return voice >= 0 && voice < 3 ? chip->voice[voice].envelope()->readENV() : 0; }
 }
