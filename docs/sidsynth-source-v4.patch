diff --git a/src/EnvelopeCue.h b/src/EnvelopeCue.h
new file mode 100644
index 0000000..1257dfe
--- /dev/null
+++ b/src/EnvelopeCue.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace sidsynth
+{
+// Format 1: four exactly representable 20-bit host parameters. These are
+// planned envelope timing cues, never live MIDI state or SID register playback.
+struct EnvelopeCue
+{
+    std::uint16_t lfsr = 0;
+    unsigned counter = 0, exponential = 0, period = 0, nextPeriod = 0;
+    unsigned state = 0, nextState = 0, statePipeline = 0, envelopePipeline = 0;
+    unsigned exponentialPipeline = 0, rate = 0;
+    std::uint32_t epoch = 0;
+    bool reset = false, enabled = false, expectedGate = false, valid = false;
+    static std::array<std::uint32_t, 4> seal(std::array<std::uint32_t, 4> w) noexcept
+    {
+        unsigned crc=0x3ff;
+        for (int i=0;i<4;++i)
+            for (int bit=(i==3?16:18)-1;bit>=0;--bit)
+            {
+                const bool feedback=((crc>>9)^(w[static_cast<std::size_t>(i)]>>bit))&1;
+                crc=((crc<<1)&0x3ff)^(feedback?0x233:0);
+            }
+        w[0]|=(crc&3)<<18;w[1]|=((crc>>2)&3)<<18;
+        w[2]|=((crc>>4)&3)<<18;w[3]|=(crc>>6)<<16;
+        return w;
+    }
+    static EnvelopeCue decode(const std::array<std::uint32_t, 4>& w) noexcept
+    {
+        EnvelopeCue c;
+        for (auto value : w) if (value > 0xfffff) return c;
+        const std::array<std::uint32_t,4> payload{w[0]&0x3ffff,w[1]&0x3ffff,w[2]&0x3ffff,w[3]&0xffff};
+        if (seal(payload)!=w) return c;
+        constexpr unsigned periods[]{0,1,2,4,8,16,30,0};
+        c.lfsr = w[0] & 0x7fff; c.reset = (w[0] & (1u << 15)) != 0;
+        c.enabled = (w[0] & (1u << 16)) != 0; c.expectedGate = (w[0] & (1u << 17)) != 0;
+        c.counter = w[1] & 255; c.exponential = (w[1] >> 8) & 31;
+        c.period = periods[(w[1] >> 13) & 7]; c.state = (w[1] >> 16)&3;
+        c.nextPeriod = periods[w[2]&7]; c.statePipeline = (w[2] >> 3) & 3;
+        c.nextState = (w[2] >> 5) & 3; c.envelopePipeline = (w[2] >> 7) & 7;
+        c.exponentialPipeline = (w[2] >> 10) & 3; c.rate = (w[2] >> 12) & 15;
+        c.epoch = w[3]&0xffff;
+        const auto period = [](unsigned n) { return n == 1 || n == 2 || n == 4 || n == 8 || n == 16 || n == 30; };
+        c.valid = c.lfsr != 0 && c.state <= 2 && c.nextState <= 2 && (w[2]&7)!=7
+            && c.exponential <= 30 && period(c.period) && (c.nextPeriod == 0 || period(c.nextPeriod))
+            && c.envelopePipeline <= 4 && c.exponentialPipeline <= 2;
+        return c;
+    }
+};
+}
